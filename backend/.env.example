# Configuración del servidor y seguridad
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de datos (por defecto SQLite local, o postgresql+psycopg://user:pass@localhost:5432/gastos)
DATABASE_URL=sqlite:///./gastos.db

# Proveedor de IA (gemini, openai o mock)
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
